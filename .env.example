# DebugMind Configuration

# ── Provider selection ─────────────────────────────────────────────────────
# Choose backend: anthropic (default) | openai | deepseek | glm
# DEBUG_MIND_PROVIDER=anthropic

# ── Anthropic (default) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key-here
# DEBUG_MIND_MODEL=claude-sonnet-4-20250514

# ── OpenAI ─────────────────────────────────────────────────────────────────
# DEBUG_MIND_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# DEBUG_MIND_MODEL=gpt-4o

# ── DeepSeek（国内可用）────────────────────────────────────────────────────
# DEBUG_MIND_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEBUG_MIND_MODEL=deepseek-chat

# ── Zhipu GLM（国内可用）──────────────────────────────────────────────────
# DEBUG_MIND_PROVIDER=glm
# ZHIPU_API_KEY=...
# DEBUG_MIND_MODEL=glm-4-flash   # or glm-4-air / glm-4

# ── Optional settings ──────────────────────────────────────────────────────
# Custom memory store directory (default: ./memory)
# DEBUG_MIND_MEMORY_DIR=/path/to/memory

# Max wall-clock seconds per diagnosis (default: 300)
# DEBUG_MIND_MAX_WALL_SECS=300
