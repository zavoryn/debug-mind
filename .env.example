# DebugMind Configuration

# Required: Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Custom memory store directory (default: ./memory)
# DEBUG_MIND_MEMORY_DIR=/path/to/memory

# Optional: LLM model to use (default: claude-sonnet-4-20250514)
# DEBUG_MIND_MODEL=claude-sonnet-4-20250514
